# Telegram Notifier Configuration (Optional)
# If left empty, notifications fall back to ConsoleNotifier.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Storage Configuration
DATABASE_PATH=trading_agent.db

# Watchlist configuration (comma-separated NSE tickers)
WATCHLIST=RELIANCE.NS,TCS.NS,INFY.NS,HDFCBANK.NS,ICICIBANK.NS
BENCHMARK_SYMBOL=^NSEI
